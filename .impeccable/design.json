      "html": "<button class=\"ds-texto\">Ver cómo preparar una evaluación</button>",
      "css": ".ds-texto{font-family:Inter,sans-serif;cursor:pointer;transition:background-color 150ms,box-shadow 150ms;background:none;border:0;color:var(--color-principal,#1a73e8);border-radius:5px;padding:10px 12px;font-size:12px;font-weight:500}.ds-texto:hover{background:#e8f0fe}.ds-texto:focus-visible{outline:2px solid var(--color-principal,#1a73e8);outline-offset:3px;}"
    },
    {
      "name": "Campo de configuración",
