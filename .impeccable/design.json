      "css": ".ds-nav{font-family:Inter,sans-serif;cursor:pointer;transition:background-color 150ms,box-shadow 150ms;display:flex;align-items:center;gap:13px;width:100%;height:44px;padding:0 18px;border:0;border-radius:0 24px 24px 0;background:#dce8fa;color:#185abc;font-size:13px;font-weight:600;text-align:left}.ds-nav:hover{background:#e8eaed}.ds-nav:focus-visible{outline:2px solid var(--color-principal,#1a73e8);outline-offset:3px;}"
    },
