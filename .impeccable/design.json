      "html": "<label class=\"ds-etiqueta\">Clave de API<input class=\"ds-campo\" type=\"password\" placeholder=\"Introduce tu clave de API\"></label>",
      "css": ".ds-etiqueta{font-family:Inter,sans-serif;font-size:12px;font-weight:500;display:block}.ds-campo{font-family:Inter,sans-serif;display:block;width:100%;height:43px;margin-top:8px;background:#fff;color:var(--color-texto,#202124);border:1px solid #dadce0;border-radius:5px;padding:0 12px;font-size:13px;font-weight:400;caret-color:var(--color-principal,#1a73e8)}.ds-campo::placeholder{color:var(--color-secundario,#5f6368);opacity:1}.ds-campo:focus-visible{outline:2px solid var(--color-principal,#1a73e8);outline-offset:3px;}"
    },
