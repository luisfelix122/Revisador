    {
      "name": "Acción primaria",
      "kind": "button",
      "refersTo": "boton-primario",
      "description": "Acción de confirmación; conservar texto de progreso y estado deshabilitado.",
      "html": "<button class=\"ds-primario\">Comprobar</button>",
      "css": ".ds-primario{font-family:Inter,sans-serif;cursor:pointer;transition:background-color 150ms,box-shadow 150ms;background:var(--color-principal,#1a73e8);color:#fff;border:1px solid var(--color-principal,#1a73e8);border-radius:6px;padding:11px 18px;min-height:40px;font-size:12px;font-weight:500}.ds-primario:hover:not(:disabled){background:#1765cc;box-shadow:0 1px 3px #20212433}.ds-primario:focus-visible{outline:2px solid var(--color-principal,#1a73e8);outline-offset:3px;}.ds-primario:disabled{cursor:not-allowed;opacity:.55}"
    },
    {
      "name": "Acción de contorno",
      "kind": "button",
      "refersTo": "boton-contorno",
      "description": "Acción secundaria en paneles.",
      "html": "<button class=\"ds-contorno\">Configurar API</button>",
      "css": ".ds-contorno{font-family:Inter,sans-serif;cursor:pointer;transition:background-color 150ms,box-shadow 150ms;background:#fff;color:var(--color-principal,#1a73e8);border:1px solid #dadce0;border-radius:5px;padding:10px 14px;font-size:11px;font-weight:500}.ds-contorno:hover{background:#e8f0fe;border-color:#b8c9e5}.ds-contorno:focus-visible{outline:2px solid var(--color-principal,#1a73e8);outline-offset:3px;}"
    },
    {
      "name": "Acción de texto",
